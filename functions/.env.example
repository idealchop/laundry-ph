# Companion Cloud Functions config (copy to functions/.env; never commit real values).
# Named Firestore database the functions read/write: laundrydb-dev (dev) or laundrydb (prod).
COMPANION_DATABASE=laundrydb-dev
# Vertex AI model and region.
COMPANION_MODEL=gemini-2.5-flash
COMPANION_VERTEX_LOCATION=asia-southeast1
# 1 = every tier gets Pro features (matches the owner app flag).
ALL_FEATURES_UNLOCKED=0
# River Bridge webhooks (dev only; triggers are bound to laundrydb-dev). Names and URLs only, never secret values.
# Leave unset to keep webhooks off. Key ids map to mylaundryph Secret Manager secrets of the same name.
# RIVER_BRIDGE_WEBHOOK_URL=https://asia-southeast1-rivermobile-ph.cloudfunctions.net/bridge/hooks/laundry
# RIVER_BRIDGE_WEBHOOK_AUDIENCE=https://asia-southeast1-rivermobile-ph.cloudfunctions.net/bridge/hooks/laundry
# RIVER_BRIDGE_WEBHOOK_KEYS=laundry-to-bridge-dev-v1,laundry-to-bridge-dev-v2
