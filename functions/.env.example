# Companion Cloud Functions config (copy to functions/.env; never commit real values).
# Named Firestore database the functions read/write: laundrydb-dev (dev) or laundrydb (prod).
COMPANION_DATABASE=laundrydb-dev
# Vertex AI model and region.
COMPANION_MODEL=gemini-2.5-flash
COMPANION_VERTEX_LOCATION=asia-southeast1
# 1 = every tier gets Pro features (matches the owner app flag).
ALL_FEATURES_UNLOCKED=0
