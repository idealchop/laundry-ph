{
  "name": "laundry-ph",
  "private": true,
  "description": "Laundry.ph: owner app for neighbourhood laundry shops (River Apps). UI scaffold with sample data.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.4",
  "engines": { "node": ">=20.9" },
  "scripts": {
    "build:packages": "pnpm --filter \"./packages/**\" -r run build",
    "dev": "pnpm build:packages && pnpm --filter @laundry-ph/owner dev",
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "start": "pnpm --filter @laundry-ph/owner start",
    "typecheck": "pnpm build:packages && pnpm -r run typecheck",
    "lint": "pnpm --filter @laundry-ph/owner lint",
    "icons:generate": "python3 packages/icons/scripts/generate.py",
    "clean": "pnpm -r exec rm -rf dist .next"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
