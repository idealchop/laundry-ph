# Copy to .env.local for local overrides. Fixtures are the default data source.
#
# Firebase project: mylaundryph (single project)
# Named DBs: laundrydb (prod) | laundrydb-dev (dev)
# Web app: "Laundry.ph Owner" (1:500578192242:web:f55828f2cb409bebc6ebeb)

NEXT_PUBLIC_DATA_SOURCE=fixtures
# NEXT_PUBLIC_DATA_SOURCE=firebase
# NEXT_PUBLIC_FIRESTORE_DATABASE=laundrydb-dev
# NEXT_PUBLIC_SHOP_ID=sample-laundry      # default shop to try before onboarding
# NEXT_PUBLIC_DEMO_FIXTURES=1             # force the in-memory demo store even with firebase config
# Local emulators (pnpm test:emulator uses these ports):
# NEXT_PUBLIC_USE_EMULATORS=true
# NEXT_PUBLIC_FIRESTORE_EMULATOR_PORT=8180
# NEXT_PUBLIC_AUTH_EMULATOR_PORT=9199

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDISQESg5cWbXLXs6i3ivOm9I6ld53hyMw
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=mylaundryph.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=mylaundryph
NEXT_PUBLIC_FIREBASE_APP_ID=1:500578192242:web:f55828f2cb409bebc6ebeb
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=mylaundryph.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=500578192242

NEXT_PUBLIC_APP_ENV=local

# Optional: Google Maps Places autocomplete on Settings (OSM works without this).
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional PayMongo (server). Without these, billing uses the demo upgrade path.
# PAYMONGO_SECRET_KEY=
# PAYMONGO_WEBHOOK_SECRET=
