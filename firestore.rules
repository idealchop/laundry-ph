rules_version = '2';

// Laundry.ph Firestore rules (project mylaundryph). Same file for laundrydb (prod) and laundrydb-dev.
// Standalone: do NOT use riverdb / aquaflow.
//
// Model (money = integer centavos, times = server timestamps):
//   users/{uid}                         { shopId }  which shop a login opens (self only)
//   shops/{shopId}                      shop profile (+ ownerUid, tier/plan, address, location, photoUrls; sample == true for demo)
//   shops/{shopId}/members/{uid}        { uid, shopId, role: owner|staff, status: active|disabled }
//   shops/{shopId}/orders/{orderId}     walk-in orders; status received→washing→drying→folding→ready→claimed|delivered
//   shops/{shopId}/customers/{id}       customers (visits, spentCentavos)
//   shops/{shopId}/meta/catalog         price list (owner writes)
//   shops/{shopId}/meta/counters        ticket number + daily queue (members bump by exactly one)
//   shops/{shopId}/meta/*, machines, pickups   read-only to members (seed / future Cloud Functions)
//   shops/{shopId}/bookings/{bookingId} River Mobile bookings: created ONLY by the Partner API (Admin SDK);
//                                       members accept / decline / mark received / complete / convert / cancel
//   booking_refs/{bookingId}            { shopId } lookup for the Partner API (Admin SDK only, no client access)
//   shops/{shopId}/usage/{yyyy-MM-dd}  { walkIns } daily walk-in counter (Partner cap 10/day, rules-enforced)
//   shops/{shopId}/companion/**, insights/{weekId}   AI Companion (functions write, owner reads)
//   staff_links/{token}                owner-published staff link (no client read; server API scopes to that shop)
//   public_tickets/{ticketId}           public-safe projection: anyone may GET one by its unguessable id, nobody may LIST
//
// Least privilege: shop data is readable/writable only by active members; field lists are
// allow-listed; nothing is deletable from the client; seeded demo shops can be JOINED as staff
// (sample == true) but their profile cannot be changed. Admin SDK (seed script) bypasses rules.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function shopPath(shopId) {
      return /databases/$(database)/documents/shops/$(shopId);
    }
    function memberPath(shopId) {
      return /databases/$(database)/documents/shops/$(shopId)/members/$(request.auth.uid);
    }
    function isMember(shopId) {
      return signedIn()
        && exists(memberPath(shopId))
        && get(memberPath(shopId)).data.status == 'active'
        && get(memberPath(shopId)).data.shopId == shopId;
    }
    function isOwner(shopId) {
      return isMember(shopId) && get(memberPath(shopId)).data.role == 'owner';
    }
    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    function isCentavos(v) {
      return v is int && v >= 0 && v <= 100000000; // ≤ ₱1,000,000
    }
    function isStatus(s) {
      return s in ['received', 'washing', 'drying', 'folding', 'ready', 'claimed', 'delivered', 'cancelled'];
    }
    function isTicketStage(s) {
      return s in ['received', 'washing', 'drying', 'folding', 'ready'];
    }
    function shortString(v, max) {
      return v is string && v.size() <= max;
    }
    // Manila calendar day "yyyy-MM-dd" (UTC+8, no DST) for the daily walk-in counter.
    function pad2(n) {
      return n < 10 ? '0' + string(n) : string(n);
    }
    function manilaDay() {
      let t = request.time + duration.value(8, 'h');
      return string(t.year()) + '-' + pad2(t.month()) + '-' + pad2(t.day());
    }
    function usagePath(shopId, day) {
      return /databases/$(database)/documents/shops/$(shopId)/usage/$(day);
    }
    // Partner: max 10 walk-ins per Manila day. The same write must bump usage/{today}.walkIns by exactly one.
    // Pro / Lifetime (tier 'paid'): unlimited.
    // Test-phase switch: config/flags {allFeaturesUnlocked: true} gives every tier Pro limits. Admin SDK writes only.
    function allUnlocked() {
      // Dev database is always unlocked (test page). Prod: create config/flags {allFeaturesUnlocked: true} to flip.
      let f = /databases/$(database)/documents/config/flags;
      return database == 'laundrydb-dev' || exists(f) && get(f).data.get('allFeaturesUnlocked', false) == true;
    }
    function walkInAllowed(shopId) {
      let before = exists(usagePath(shopId, manilaDay())) ? get(usagePath(shopId, manilaDay())).data.walkIns : 0;
      let after = getAfter(usagePath(shopId, manilaDay())).data.walkIns;
      return allUnlocked() || get(shopPath(shopId)).data.tier == 'paid' || (after == before + 1 && after <= 10);
    }
    function bookingPath(shopId, bookingId) {
      return /databases/$(database)/documents/shops/$(shopId)/bookings/$(bookingId);
    }
    // Booking status move by a shop member: only the listed fields change, statusTimes gains exactly the new status,
    // and the write is stamped with the member + server time.
    function bookingMove(from, to, extra) {
      return resource.data.status in from
        && request.resource.data.status == to
        && changedOnly(['status', 'statusTimes', 'updatedAt', 'updatedBy'].concat(extra))
        && request.resource.data.statusTimes.diff(resource.data.get('statusTimes', {})).affectedKeys().hasOnly([to])
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }

    // ---------- feature flags ----------
    match /config/flags {
      allow read: if true;
      allow write: if false;
    }

    // ---------- staff links ----------
    // staff_links/{token}: the owner publishes a shop's staff link. No browser can read or list it;
    // /api/staff/{token} (Admin SDK) checks it and only touches that shop's orders + usage counter.
    match /staff_links/{token} {
      allow read: if false;
      allow create, update: if token.size() >= 20 && token.size() <= 40
        && isOwner(request.resource.data.shopId)
        && request.resource.data.ownerUid == request.auth.uid
        && (resource == null || resource.data.shopId == request.resource.data.shopId)
        && request.resource.data.keys().hasOnly(['shopId', 'branchId', 'branchName', 'shopName', 'ownerUid', 'expiresAt', 'updatedAt'])
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt < request.time + duration.value(40, 'd')
        && shortString(request.resource.data.branchName, 60)
        && shortString(request.resource.data.shopName, 80);
      allow delete: if false;
    }

    // ---------- users ----------
    match /users/{uid} {
      allow read: if isSelf(uid);
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['shopId', 'updatedAt'])
        && request.resource.data.shopId is string
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // ---------- shops ----------
    match /shops/{shopId} {
      // Members read their shop; any signed-in user may read a seeded demo shop's profile (to join it).
      allow get: if isMember(shopId) || (signedIn() && resource.data.sample == true);
      allow list: if false;

      // Create your own shop: you are the owner; it can never be a sample shop.
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.id == shopId
        && request.resource.data.sample == false
        && request.resource.data.tier in ['paid', 'partner']
        && shortString(request.resource.data.name, 80)
        && request.resource.data.name.size() >= 2
        && request.resource.data.keys().hasOnly([
          'id', 'name', 'area', 'ownerName', 'ownerAvatar', 'tier', 'ownerUid', 'sample', 'dailyTargetCentavos', 'createdAt',
          'address', 'location', 'photoUrls', 'planSource', 'planExpiresAt', 'about'
        ])
        && shortString(request.resource.data.get('about', ''), 300)
        && request.resource.data.createdAt == request.time;

      // Owner edits profile, address/map pin, or plan (demo billing until PayMongo webhook owns plan writes).
      // Ownership and sample flag stay immutable. Sample shops cannot be edited.
      allow update: if isOwner(shopId)
        && resource.data.sample != true
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.sample == resource.data.sample
        && request.resource.data.tier in ['paid', 'partner']
        && shortString(request.resource.data.get('about', ''), 300)
        && changedOnly([
          'name', 'area', 'ownerName', 'ownerAvatar', 'dailyTargetCentavos', 'about',
          'address', 'location', 'photoUrls', 'photosUpdatedAt', 'tier', 'planSource', 'planExpiresAt', 'planUpdatedAt'
        ]);
      allow delete: if false;

      match /members/{uid} {
        allow read: if isMember(shopId) || isSelf(uid);
        // Self-join only: as owner of a shop you are creating in the same batch, or as staff of a demo shop.
        allow create: if isSelf(uid)
          && request.resource.data.uid == uid
          && request.resource.data.shopId == shopId
          && request.resource.data.status == 'active'
          && request.resource.data.keys().hasOnly(['uid', 'shopId', 'role', 'status', 'joinedVia', 'displayName', 'phone', 'email', 'createdAt'])
          && request.resource.data.createdAt == request.time
          && (
            (request.resource.data.role == 'owner'
              && getAfter(shopPath(shopId)).data.ownerUid == request.auth.uid)
            || (request.resource.data.role == 'staff'
              && get(shopPath(shopId)).data.sample == true)
          );
        // Owners manage other members' role / status; nobody edits their own membership.
        allow update: if isOwner(shopId) && !isSelf(uid)
          && changedOnly(['role', 'status'])
          && request.resource.data.role in ['owner', 'staff']
          && request.resource.data.status in ['active', 'disabled'];
        allow delete: if false;
      }

      match /orders/{orderId} {
        allow read: if isMember(shopId);
        allow create: if isMember(shopId)
          && request.resource.data.shopId == shopId
          && request.resource.data.keys().hasAll(['ref', 'queueNo', 'ticketId', 'status', 'customer', 'serviceId', 'quantity', 'kg', 'lines', 'totalCentavos', 'createdAt'])
          && request.resource.data.keys().hasOnly([
            'shopId', 'ref', 'queueNo', 'ticketId', 'source', 'status', 'customer', 'customerId', 'serviceId', 'serviceName', 'unit',
            'quantity', 'billedQuantity', 'kg', 'detergent', 'addOns', 'clothesType', 'lines', 'subtotalCentavos', 'totalCentavos',
            'paymentStatus', 'paymentMethod', 'paidCentavos', 'readyBy', 'fulfillment', 'detail', 'stageTimes', 'createdAt', 'updatedAt', 'createdBy', 'sample',
            'bookingId'
          ])
          && request.resource.data.status == 'received'
          && (
            (request.resource.data.source == 'walk-in' && !('bookingId' in request.resource.data) && walkInAllowed(shopId))
            // Converted River Mobile booking: the same batch must flip that booking to converted → this order.
            || (request.resource.data.source == 'river-mobile'
              && request.resource.data.bookingId is string
              && getAfter(bookingPath(shopId, request.resource.data.bookingId)).data.status == 'converted'
              && getAfter(bookingPath(shopId, request.resource.data.bookingId)).data.orderId == orderId)
          )
          && request.resource.data.get('fulfillment', 'pickup') in ['pickup', 'delivery']
          && request.resource.data.ref is string && request.resource.data.ref.matches('LDY-[0-9]{4,6}')
          && request.resource.data.ticketId is string && request.resource.data.ticketId.matches('LDY-[0-9]{4,6}-[A-Z0-9]{8}')
          && request.resource.data.kg is number && request.resource.data.kg >= 0 && request.resource.data.kg <= 200
          && request.resource.data.quantity is number && request.resource.data.quantity > 0
          && isCentavos(request.resource.data.totalCentavos)
          && isCentavos(request.resource.data.subtotalCentavos)
          && request.resource.data.paymentStatus == 'unpaid'
          && request.resource.data.paidCentavos == 0
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && (!('sample' in request.resource.data) || request.resource.data.sample == true);
        // Status moves, payments. Identity, lines and totals are immutable.
        allow update: if isMember(shopId)
          && changedOnly(['status', 'stageTimes', 'paymentStatus', 'paymentMethod', 'paidCentavos', 'paidAt', 'updatedAt', 'updatedBy'])
          && isStatus(request.resource.data.status)
          && request.resource.data.get('paymentStatus', 'unpaid') in ['unpaid', 'paid']
          && request.resource.data.get('paymentMethod', null) in [null, 'cash', 'gcash']
          && isCentavos(request.resource.data.get('paidCentavos', 0))
          && request.resource.data.get('paidCentavos', 0) <= resource.data.get('totalCentavos', 0)
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }

      match /customers/{customerId} {
        allow read: if isMember(shopId);
        allow create: if isMember(shopId)
          && request.resource.data.keys().hasOnly(['name', 'nameLower', 'phone', 'avatar', 'source', 'visits', 'spentCentavos', 'tag', 'notes', 'lastVisitAt', 'createdAt', 'updatedAt', 'createdBy'])
          && shortString(request.resource.data.name, 80) && request.resource.data.name.size() > 0
          && (request.resource.data.phone == null || shortString(request.resource.data.phone, 20))
          && (request.resource.data.notes == null || shortString(request.resource.data.notes, 500))
          && request.resource.data.source in ['Walk-in', 'River Mobile']
          && request.resource.data.visits is int && request.resource.data.visits >= 0 && request.resource.data.visits <= 1
          && isCentavos(request.resource.data.spentCentavos)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow update: if isMember(shopId)
          && changedOnly(['name', 'nameLower', 'phone', 'avatar', 'tag', 'notes', 'visits', 'spentCentavos', 'lastVisitAt', 'updatedAt'])
          && shortString(request.resource.data.name, 80)
          && request.resource.data.get('visits', 0) is int && request.resource.data.get('visits', 0) >= resource.data.get('visits', 0)
          && isCentavos(request.resource.data.get('spentCentavos', 0))
          && request.resource.data.get('tag', null) in [null, 'Member', 'Regular', 'New']
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }

      // AI Companion (Cloud Functions / Admin SDK write everything; owner read only).
      //   companion/goal, companion/usage-*, companion/refresh, companion/chat/messages/{id}
      //   insights/{weekId}  weekly tips (Partner docs only ever contain the 1 teaser tip)
      match /companion/{document=**} {
        allow read: if isOwner(shopId);
        allow write: if false;
      }
      match /insights/{weekId} {
        allow read: if isOwner(shopId);
        allow write: if false;
      }

      // Daily walk-in counter (Manila day id). Only today's doc, only +1 per write, never deleted.
      match /usage/{day} {
        allow read: if isMember(shopId);
        allow create: if isMember(shopId) && day == manilaDay()
          && request.resource.data.keys().hasOnly(['walkIns', 'updatedAt'])
          && request.resource.data.walkIns == 1;
        allow update: if isMember(shopId) && day == manilaDay()
          && request.resource.data.keys().hasOnly(['walkIns', 'updatedAt'])
          && request.resource.data.walkIns == resource.data.walkIns + 1;
        allow delete: if false;
      }

      match /meta/{docId} {
        allow read: if isMember(shopId);
        allow write: if false;
      }
      match /meta/counters {
        allow read: if isMember(shopId);
        allow create: if isMember(shopId)
          && request.resource.data.keys().hasOnly(['nextTicketNo', 'queueDate', 'queueNo', 'updatedAt'])
          && request.resource.data.nextTicketNo is int && request.resource.data.nextTicketNo >= 1
          && request.resource.data.queueNo is int
          && request.resource.data.queueDate is string;
        allow update: if isMember(shopId)
          && request.resource.data.keys().hasOnly(['nextTicketNo', 'queueDate', 'queueNo', 'updatedAt'])
          && request.resource.data.nextTicketNo == resource.data.nextTicketNo + 1
          && request.resource.data.queueNo is int && request.resource.data.queueNo >= 1
          && request.resource.data.queueDate is string;
        allow delete: if false;
      }
      match /meta/catalog {
        allow read: if isMember(shopId);
        allow create, update: if isOwner(shopId);
        allow delete: if false;
      }

      match /machines/{machineId} {
        allow read: if isMember(shopId);
        allow write: if false;
      }
      match /pickups/{pickupId} {
        allow read: if isMember(shopId);
        allow write: if false;
      }

      // River Mobile bookings. No client create / delete: the Partner API (Admin SDK) creates them.
      match /bookings/{bookingId} {
        allow read: if isMember(shopId);
        allow create, delete: if false;
        allow update: if isMember(shopId) && (
          bookingMove(['requested'], 'accepted', [])
          || (bookingMove(['requested'], 'declined', ['declineReason'])
            && (request.resource.data.declineReason == null || shortString(request.resource.data.declineReason, 200)))
          || bookingMove(['accepted'], 'received', [])
          || bookingMove(['accepted', 'received'], 'completed', [])
          || (bookingMove(['accepted', 'received'], 'cancelled', ['cancelReason', 'cancelledBy'])
            && request.resource.data.cancelledBy == 'shop'
            && (request.resource.data.cancelReason == null || shortString(request.resource.data.cancelReason, 200)))
          // Convert: the same batch creates shops/{shopId}/orders/{orderId} pointing back at this booking.
          || (bookingMove(['requested', 'accepted', 'received'], 'converted', ['orderId'])
            && request.resource.data.orderId is string
            && getAfter(/databases/$(database)/documents/shops/$(shopId)/orders/$(request.resource.data.orderId)).data.bookingId == bookingId)
        );
      }
    }

    // ---------- public tickets (customer page /t/[ticketId], no login) ----------
    match /public_tickets/{ticketId} {
      // Get by exact id only (ids carry an 8-char random suffix); listing / enumerating is denied.
      allow get: if true;
      allow list: if false;
      allow create: if isMember(request.resource.data.shopId)
        && request.resource.data.keys().hasOnly([
          'shopId', 'shopName', 'ref', 'queueNo', 'maskedName', 'stage', 'done', 'cancelled', 'stageTimes', 'readyBy',
          'updatedAt', 'kg', 'quantityLabel', 'serviceName', 'clothesType', 'totalCentavos', 'amountDueCentavos', 'paid', 'sample'
        ])
        && (!('clothesType' in request.resource.data) || shortString(request.resource.data.clothesType, 80))
        && ticketId.matches('LDY-[0-9]{4,6}-[A-Z0-9]{8}')
        && isTicketStage(request.resource.data.stage)
        && shortString(request.resource.data.maskedName, 40)
        && isCentavos(request.resource.data.totalCentavos)
        && isCentavos(request.resource.data.amountDueCentavos);
      allow update: if isMember(resource.data.shopId)
        && request.resource.data.shopId == resource.data.shopId
        && changedOnly(['stage', 'done', 'cancelled', 'stageTimes', 'updatedAt', 'paid', 'amountDueCentavos'])
        && isTicketStage(request.resource.data.stage)
        && isCentavos(request.resource.data.get('amountDueCentavos', 0));
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
